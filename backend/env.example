PORT=your_port
NODE_ENV=your_environment
MONGO_URI=your_mongo_uri

# Groq (api.groq.com) — 키는 gsk_ 로 시작합니다. https://console.groq.com
# 주의: Groq 와 Grok/xAI(api.x.ai, xai- 키)는 이름만 비슷한 다른 서비스입니다.
GROQ_API_KEY=your_groq_api_key
# 선택: 기본값은 각각 https://api.groq.com/openai/v1 / llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
