PORT=your_port
NODE_ENV=your_environment
MONGO_URI=your_mongo_uri

# CORS 허용 origin (콤마 구분). 미설정 시 config.js 의 기본 목록을 사용합니다.
# 프로토콜까지 정확히 적어야 하고, 끝에 슬래시를 붙이면 안 됩니다.
# Vercel preview 도메인(jsl-logistics-frontend-*.vercel.app)은 정규식으로
# 별도 허용되므로 여기에 나열할 필요가 없습니다.
ALLOWED_ORIGINS=http://localhost:3000,https://jsl-project.vercel.app

# Groq (api.groq.com) — 키는 gsk_ 로 시작합니다. https://console.groq.com
# 주의: Groq 와 Grok/xAI(api.x.ai, xai- 키)는 이름만 비슷한 다른 서비스입니다.
GROQ_API_KEY=your_groq_api_key
# 선택: 기본값은 각각 https://api.groq.com/openai/v1 / llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
