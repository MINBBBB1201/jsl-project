PORT=your_port
NODE_ENV=your_environment
MONGO_URI=your_mongo_uri

# ── 인증 ────────────────────────────────────────────────────────────────
# JWT 서명 키 (필수). 없으면 서버가 시작되지 않습니다.
# 개발용 기본값을 코드에 두지 않는 이유: 그대로 배포되면 누구나 관리자 토큰을
# 위조할 수 있기 때문입니다. 환경마다 다른 값을 쓰세요.
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret
# 선택: 토큰 유효기간 (기본 12h)
JWT_EXPIRES_IN=12h

# 관리자 계정 시드
#   npm run seed:admin                      (기본 admin@jsl-logis.com)
#   npm run seed:admin -- --reset-password  (비밀번호 재발급)
# 비밀번호는 이 파일이나 코드에 적지 않습니다. 아래 값을 비워 두면 시드 스크립트가
# 무작위 비밀번호를 만들어 실행 시 콘솔에 한 번만 출력합니다. 그 값을 옮겨 적어 두세요.
# SEED_ADMIN_EMAIL=admin@jsl-logis.com
# SEED_ADMIN_PASSWORD=

# CORS 허용 origin (콤마 구분). 미설정 시 config.js 의 기본 목록을 사용합니다.
# 프로토콜까지 정확히 적어야 하고, 끝에 슬래시를 붙이면 안 됩니다.
# Vercel preview 도메인(jsl-logistics-frontend-*.vercel.app)은 정규식으로
# 별도 허용되므로 여기에 나열할 필요가 없습니다.
ALLOWED_ORIGINS=http://localhost:3000,https://jsl-project.vercel.app

# DNS 리졸버 오버라이드 (콤마 구분) — 문제가 있는 로컬 PC 에서만 설정하세요.
#
# Node 가 시스템 DNS 를 127.0.0.1 로 잡는데 거기서 응답이 없으면
# mongodb+srv 의 SRV 조회가 실패해 서버가 뜨지 않습니다:
#   MongoDB Atlas connection error: querySrv ECONNREFUSED _mongodb._tcp...
# 이 경우에만 아래 주석을 풀어 이 프로세스의 리졸버를 지정하세요.
#
# 배포 환경(Render)과 docker-compose 에서는 설정하지 마세요.
# 내부 호스트명 해석이 깨질 수 있습니다. 미설정 시 아무 동작도 하지 않습니다.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Groq (api.groq.com) — 키는 gsk_ 로 시작합니다. https://console.groq.com
# 주의: Groq 와 Grok/xAI(api.x.ai, xai- 키)는 이름만 비슷한 다른 서비스입니다.
GROQ_API_KEY=your_groq_api_key
# 선택: 기본값은 각각 https://api.groq.com/openai/v1 / llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
