{
  "name": "jsl-landing-review-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated developer tools for reference, motion and visual review; no production frontend dependencies.",
  "scripts": {
    "verify:mcp": "node verify-mcp.mjs",
    "checkpoint": "node checkpoint.mjs save",
    "verify:scope": "node checkpoint.mjs verify",
    "verify:pipeline": "node verify-pipeline.mjs",
    "image:diff": "node image-diff.mjs",
    "asset:check": "node asset-check.mjs",
    "video:frames": "node video-frames.mjs",
    "gltf": "gltf-transform"
  },
  "dependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@playwright/mcp": "0.0.83",
    "@upstash/context7-mcp": "4.1.1",
    "chrome-devtools-mcp": "1.10.1",
    "ffmpeg-static": "5.3.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "next-devtools-mcp": "0.4.0",
    "pixelmatch": "7.2.0",
    "sharp": "0.35.5"
  }
}
